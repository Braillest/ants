# Ignore local ENV files
*.local

# Ignore data volumes
docker/development/queen/redis/data/*
docker/production/queen/redis/data/*
docker/development/queen/mariadb/data/*
docker/production/queen/mariadb/data/*

# Ignore log volumes
docker/development/queen/nginx/logs/*
docker/production/queen/nginx/logs/*
docker/development/queen/redis/logs/*
docker/production/queen/redis/logs/*

# Ignore build outputs
bin
obj
__pycache__
node_modules

# Keep directory structure
!.gitkeep
